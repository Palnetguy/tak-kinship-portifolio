# Copy to `.env.local` for local dev, and set the same key in the Vercel
# project's Environment Variables. `.env*` is gitignored; this file is not,
# and must never hold a real value.

# TAK's own backend (https://takkinship-backend.up.railway.app/api).
# Server-side only: it is read in src/lib/tak-api.ts, which throws if it is
# ever imported into client code, so this value is never sent to a browser.
#
# Leave it UNSET and the site renders the vetted static content instead. That
# is a supported state, not a broken one.
TAK_API_KEY=

# Cloudflare Turnstile bot protection for the public contact form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
