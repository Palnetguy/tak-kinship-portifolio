# Server-only credential used by Next.js when calling the TAK backend.
# Never prefix this value with NEXT_PUBLIC_ or commit a real key.
TAK_API_KEY=

# Production may omit this because the Railway backend is the default.
# Set it for local development, for example http://127.0.0.1:8000/api.
TAK_API_BASE_URL=

# Cloudflare Turnstile. The site key is public; the secret remains server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
